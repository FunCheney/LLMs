# ops 用的环境模板：cp .env.example .env（.env 已被 .gitignore 忽略）
#
# 铁律：密钥只走环境变量，不进镜像层、不进 yaml、不进日志（日志里只有 mask 后的形态）。

# -- 供应商（与 models.yaml 的 api_key_env 必须一致） ------------------------ #
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# -- 服务 -------------------------------------------------------------------- #
LOG_LEVEL=INFO

# memory = 单进程；redis = 多副本（compose 里默认 redis）
SESSION_BACKEND=redis
REDIS_URL=redis://redis:6379/0
SESSION_TTL_S=86400
SESSION_MAX_TURNS=50

# 入口过载：等这么久还拿不到并发槽位就 503 + Retry-After
OVERLOAD_WAIT_S=0.25
TASK_QUEUE_SIZE=100
TASK_WORKERS=2

# 首 token 超时是流式重试的判定边界（W1 的 10s 仍待真机校准）
FIRST_TOKEN_TIMEOUT_S=10
MAX_ATTEMPTS=3

# -- 检索 / RAG --------------------------------------------------------------- #
# 变量名必须与 Settings 字段同名（pydantic-settings 无前缀，大写即 env 名）。
# 写错名字不会报错，只会静默用默认值——所以这里不要自创缩写。
#
# sparse = 纯 BM25（不需要 torch，CI 默认走这条）；dense = 纯向量；hybrid = 两路 RRF。
# **Settings 的默认值是 dense**（实测最优，见 docs/w5/rag-ab-report.md）。
# 这里显式写 sparse 是因为容器镜像没有 torch（`uv sync --no-dev` 不带 local extra），
# dense 在镜像里会 ImportError。本机裸进程跑 dense 时把这行删掉或改成 dense。
# hybrid 实测是负收益（R@1 .571 vs dense .786），不要当"更稳的折中"开。
RETRIEVAL_MODE=sparse
# 向量库：local（pickle，默认）| pgvector | milvus
VECTOR_STORE=local
# 语料根目录（rag.py 直接读 os.getenv，不走 Settings）
RAG_ROOT=./data
# 整链路预算。**开精排必须同时调大**：精排超时取 min(rerank_timeout, 剩余预算)，
# 预算 800 时剩余约 500ms，精排 20 条要 4.7s → 每次都被掐断，静默降级回召回顺序。
RETRIEVAL_BUDGET_MS=800
RETRIEVAL_TOP_K=8
# 精排：**能力保留、默认关**。开关是真的有效（不是死开关），只是这批语料上实测为
# 负收益（R@1 .786→.714、MRR .863→.815、p95 +5s，见 ADR-W5-01 D7）。
# 要开就三个值一起给，缺一个都会静默失效：
#   RETRIEVAL_RERANK=true
#   RETRIEVAL_BUDGET_MS=8500        # ≥ rerank_timeout(8000) + 500ms 召回余量
#   RETRIEVAL_DEVICE=cpu            # macOS 必设，否则 MPS 多线程断言直接杀进程
# 启动时 rerank_preflight() 会检查这三条，不自洽直接打 WARNING 并指出该改哪个值。
RETRIEVAL_RERANK=false

# -- W6：溯源 / 上下文组装 / 治理 / ACL -------------------------------------- #
# /v1/answer 的 context 预算（token，粗估）。3000 ≈ 6–8 个块；再大不会提升质量，
# 反而触发 lost-in-the-middle（最相关的内容被夹在中间被忽略）。
RETRIEVAL_TOKEN_BUDGET=3000
# 留给"引用规则 + 问题 + 答案"的余量。不留会出现 finish_reason=length 与半句答案，
# 而日志上看是"检索很成功"。
RETRIEVAL_CONTEXT_RESERVE_TOKENS=600
# 近重复合并阈值（4-gram Jaccard）。同一段反复进 context → 调小（如 0.85）；
# 把不同段误合并 → 调大（如 0.95）。
RETRIEVAL_DEDUPE_THRESHOLD=0.9
# 首尾放置（lost-in-the-middle 缓解）。只改"给模型看的顺序"，不改检索名次。
RETRIEVAL_ATTENTION_ORDERING=true
# 单块进 context 的字符上限。太大会让前几块吃掉整个预算。
RETRIEVAL_CITATION_MAX_CHARS=800
# 治理三条（质量降权 / 过期降权 / 冲突标注）。默认开：只乘权重、只加提示，
# 不删数据；关掉不会变快，只会变脏。
RETRIEVAL_GOVERNANCE=true

# ACL：默认**关**（当前语料没有任何 acl 标注，开了等于全拒）。但策略默认是
# "拒绝未标注"，别为了跑通改成 allow_unlabeled=true —— "没开 ACL" 与
# "开了但谁都能看" 在审计里是两件事。开启后主体来自请求头
# X-Principal-Id / X-Principal-Groups（真鉴权在 W10）。
RETRIEVAL_ACL_ENABLED=false
RETRIEVAL_ACL_ALLOW_UNLABELED=false

# 回答的路由档位与温度。温度显式下发：留空时各厂商默认不同（0.7/1.0），
# 换模型答案风格与引用行为都会变。评测固定跑 0（见 citation_accuracy.py）。
ANSWER_TASK=chat
ANSWER_MAX_TOKENS=800
ANSWER_TEMPERATURE=0.2
# 向量库连接串。**两个场景的 host 不一样，写错了只会在运行时报连不上库**：
#   - compose 里的服务（本文件就是给它们读的）：host 用服务名、端口用容器内 5432
#   - 本机脚本/uv run 直跑：host 用 localhost、端口用映射出来的 5433
PGVECTOR_DSN=postgresql://rag:rag@pgvector:5432/rag
# 本机直跑时改成下面这行：
# PGVECTOR_DSN=postgresql://rag:rag@localhost:5433/rag

# -- W10：我方鉴权（对外提供服务时必须开） ---------------------------------- #
# off = 不校验（开发/测试/内网）；key = 校验下面的 API_KEYS。
# **默认 off 只适合开发**：只要这个地址别人能访问到，就必须设成 key。
AUTH_MODE=off
# 格式 `key=subject:group1|group2`，逗号分隔；`=subject` 可省。
# 不写 subject 时用 key 的哈希前 8 位——**不会**把 key 本身写进日志与 ACL。
# 生产档（docker-compose.prod.yml）会强制 AUTH_MODE=key，这里留空会启动失败。
# API_KEYS=sk-live-xxxxxxxx=alice:admin

# -- W10：生产档（仅 docker-compose.prod.yml 读） ---------------------------- #
# 域名，caddy 用它申请证书；缺了 caddy 拒绝启动（比"起了但证书不对"好）。
# SITE_ADDRESS=growth.example.com
# ACME_EMAIL=you@example.com

# -- 可选：长任务工作流 ------------------------------------------------------ #
TEMPORAL_ADDRESS=temporal:7233
