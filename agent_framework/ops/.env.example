# ops 用的环境模板：cp .env.example .env（.env 已被 .gitignore 忽略）
#
# 铁律：密钥只走环境变量，不进镜像层、不进 yaml、不进日志（日志里只有 mask 后的形态）。

# -- 供应商（与 models.yaml 的 api_key_env 必须一致） ------------------------ #
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# -- 服务 -------------------------------------------------------------------- #
LOG_LEVEL=INFO

# memory = 单进程；redis = 多副本（compose 里默认 redis）
SESSION_BACKEND=redis
REDIS_URL=redis://redis:6379/0
SESSION_TTL_S=86400
SESSION_MAX_TURNS=50

# 入口过载：等这么久还拿不到并发槽位就 503 + Retry-After
OVERLOAD_WAIT_S=0.25
TASK_QUEUE_SIZE=100
TASK_WORKERS=2

# 首 token 超时是流式重试的判定边界（W1 的 10s 仍待真机校准）
FIRST_TOKEN_TIMEOUT_S=10
MAX_ATTEMPTS=3

# -- 检索 / RAG --------------------------------------------------------------- #
# 变量名必须与 Settings 字段同名（pydantic-settings 无前缀，大写即 env 名）。
# 写错名字不会报错，只会静默用默认值——所以这里不要自创缩写。
#
# sparse = 纯 BM25（不需要 torch，CI 默认走这条）；dense = 纯向量；
# hybrid = 两路 RRF 融合。dense/hybrid 需要本地 bge-m3。
RETRIEVAL_MODE=sparse
# 向量库：local（pickle，默认）| pgvector | milvus
VECTOR_STORE=local
# 语料根目录（rag.py 直接读 os.getenv，不走 Settings）
RAG_ROOT=./data
# 整链路预算。开精排必须调大，否则每次都在 budget_exhausted 降级
RETRIEVAL_BUDGET_MS=800
RETRIEVAL_TOP_K=8
# 精排默认关：cross-encoder 精排 20 条约 2.5s，会直接吃掉默认预算
RETRIEVAL_RERANK=false
# 向量库连接串。**两个场景的 host 不一样，写错了只会在运行时报连不上库**：
#   - compose 里的服务（本文件就是给它们读的）：host 用服务名、端口用容器内 5432
#   - 本机脚本/uv run 直跑：host 用 localhost、端口用映射出来的 5433
PGVECTOR_DSN=postgresql://rag:rag@pgvector:5432/rag
# 本机直跑时改成下面这行：
# PGVECTOR_DSN=postgresql://rag:rag@localhost:5433/rag

# -- 可选：长任务工作流 ------------------------------------------------------ #
TEMPORAL_ADDRESS=temporal:7233
