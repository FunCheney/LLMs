# ops 用的环境模板：cp .env.example .env（.env 已被 .gitignore 忽略）
#
# 铁律：密钥只走环境变量，不进镜像层、不进 yaml、不进日志（日志里只有 mask 后的形态）。

# -- 供应商（与 models.yaml 的 api_key_env 必须一致） ------------------------ #
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# -- 服务 -------------------------------------------------------------------- #
LOG_LEVEL=INFO

# memory = 单进程；redis = 多副本（compose 里默认 redis）
SESSION_BACKEND=redis
REDIS_URL=redis://redis:6379/0
SESSION_TTL_S=86400
SESSION_MAX_TURNS=50

# 入口过载：等这么久还拿不到并发槽位就 503 + Retry-After
OVERLOAD_WAIT_S=0.25
TASK_QUEUE_SIZE=100
TASK_WORKERS=2

# 首 token 超时是流式重试的判定边界（W1 的 10s 仍待真机校准）
FIRST_TOKEN_TIMEOUT_S=10
MAX_ATTEMPTS=3

# -- 可选：长任务工作流 ------------------------------------------------------ #
TEMPORAL_ADDRESS=temporal:7233
