# 环境变量模板
# 用法：cp .env.example .env.local 后填入真实值；.env* 已在 .gitignore 中忽略

# 框架/服务
TEMPORAL_ADDRESS=localhost:7233          # W2 起使用（长任务工作流）
LOG_LEVEL=INFO

# 模型供应商（W1 至少准备 3 个）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=                        # Qwen / 阿里云百炼

# 观测后端（W3 起使用）。缺 key 时 exporter 自动降级为 Noop，评测与 CI 不受影响。
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
